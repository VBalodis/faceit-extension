{
  "manifest_version": 3,
  "name": "FACEIT Deathnote",
  "version": "1.0.1",

  "action": {
    "default_title": "FACEIT Deathnote"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "host_permissions": [
    "https://www.faceit.com/",
    "https://*.vercel.app/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.faceit.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}